# Copy to .env.local and fill in real values there. Never commit .env.local
# or put real secrets in this file — this one is the public template.

# Supabase project settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com -> API keys. Used server-side only, for the
# handwritten price board scanner at /picker/scan.
ANTHROPIC_API_KEY=

# Shared secret for /picker (GET /api/picker poll + mutates: prices, pick
# ticks, order status) and courier live-order status writes.
# When set, staff unlock once in the picker UI; an httpOnly cookie is stored.
# Leave unset for an open local demo (reads and mutates stay ungated).
PICKER_SECRET=
